<% content_for :title, "Account suspended - Pairin" %>

<div class="px-6 md:px-16 lg:px-24 py-16 md:py-20 max-w-2xl mx-auto">
  <a href="<%= root_path %>" class="text-sm font-bold text-purple hover:underline">&larr; Back to Pairin</a>

  <h1 class="font-display font-extrabold text-4xl tracking-tight leading-none mt-6 mb-6">Your account is suspended</h1>

  <p class="text-gray-700">
    Sorry, we can't keep your account due to an age restriction. It's hidden from others now, and we'll delete it
    and its data in <%= User::SUSPENSION_GRACE_PERIOD.in_days.to_i %> days. If this is a mistake, contact us at
    <a href="mailto:hello@pairin.dev" class="text-purple font-bold">hello@pairin.dev</a> before then.
  </p>
</div>
