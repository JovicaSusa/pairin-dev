<% tech_icons = %w[
  rails-plain-wordmark c-plain clojure-line csharp-plain css3-plain docker-plain
  dot-net-plain flutter-plain go-original-wordmark javascript-plain kotlin-plain
  kubernetes-plain ruby-plain rust-plain python-plain typescript-plain vuejs-plain react-original
] %>

<% faqs = [
  { q: "What is Pairin?", a: "Pairin helps people learning programming find a steady partner. You post what you want to learn and talk to the people who apply. If it's a good fit, you both commit and get a private Workspace." },
  { q: "Is Pairin free?", a: "Yes. Pairin is free during its beta." },
  { q: "How do I find a partner?", a: "Post a partner search, or browse other people's searches and apply. Once you've signed in, you can filter by tag, commitment, level and language." },
  { q: "Do I have to book a session or a call?", a: "No. There are no time slots and no intro calls. You talk in the app first, then the two of you decide how and when to work together." },
  { q: "What's in a Workspace?", a: "It's private to the two of you, with your chat, an optional shared goal, how long you each committed to, and a weekly check-in." },
  { q: "What if it isn't a good fit?", a: "Either of you can choose Not a match, which ends the chat. You can also block or report someone if you need to." },
  { q: "What can I learn?", a: "Any language or stack, at any level, whether you're self-taught, a student or a working developer picking up something new." },
  { q: "Is there a minimum age?", a: "Yes, you need to be at least 16. People under 18 only see and talk to others under 18." },
] %>

<% faq_json_ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map { |faq| { "@type": "Question", name: faq[:q], acceptedAnswer: { "@type": "Answer", text: faq[:a] } } },
} %>

<script type="application/ld+json"><%== faq_json_ld.to_json %></script>

<%# Mobile nav toggle — no JS required %>
<input type="checkbox" id="nav-toggle" class="hidden peer/nav" />

<header class="w-full border-b-4 px-2 border-black bg-yellow-50 font-bold sticky top-0 z-10">
  <div class="flex flex-col max-w-screen-xl py-2 mx-auto md:items-center md:justify-between md:flex-row md:px-6 lg:px-8">
    <div class="flex items-center justify-between lg:justify-start">
      <div class="flex items-center justify-center space-x-2">
        <%= link_to root_path, class: "flex items-center gap-2" do %>
          <%= image_tag "logo.svg", alt: "logo", class: "h-8 w-8" %>
          <span class="font-display text-xl font-extrabold tracking-tight">pairin</span>
        <% end %>
      </div>

      <label for="nav-toggle" class="rounded-lg md:hidden cursor-pointer" aria-label="Toggle menu">
        <%= image_tag "hamburger.svg", alt: "menu", class: "w-8 h-8" %>
      </label>
    </div>

    <nav class="flex-col flex-grow mt-4 hidden peer-checked/nav:flex md:flex md:justify-end md:flex-row">
      <ul class="space-y-2 list-none lg:space-y-0 lg:items-center lg:inline-flex">
        <li>
          <a href="/users/sign_in" class="px-2 lg:px-6 py-6 text-sm border-b-2 border-transparent leading-[22px] md:px-3 text-black">
            Login
          </a>
        </li>
        <li>
          <a
            href="/users/sign_up"
            class="inline-block font-headline font-bold text-sm px-4 py-2 rounded-md border-2 border-black bg-purple text-white shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none"
          >
            Sign up
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<%# HERO — copy left, an example of the flow right %>
<section class="px-6 md:px-16 lg:px-24 pt-12 pb-12 md:pt-20 md:pb-20 grid md:grid-cols-2 gap-12 md:gap-20 items-center border-b-4 border-black">
  <div>
    <div class="inline-flex items-center gap-2 bg-white border-2 border-black rounded-full px-4 py-1.5 text-sm font-bold mb-6 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
      Free during beta
    </div>

    <h1 class="font-display font-extrabold text-5xl md:text-6xl lg:text-7xl leading-tight tracking-tight mb-5">
      Learn programming with
      <span class="bg-orange text-black px-2 rounded-md inline-block leading-tight">a partner</span>,
      not alone.
    </h1>

    <p class="text-gray-600 text-lg leading-relaxed max-w-md mb-8">
      Post what you want to learn. Talk to the people who apply. When you find a good fit, you both commit and get a private Workspace to keep going.
    </p>

    <div class="flex flex-wrap gap-3">
      <a
        href="/users/sign_up"
        class="font-headline font-bold text-base px-7 py-3.5 rounded-md border-2 border-black bg-purple text-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none"
      >
        Find a partner &rarr;
      </a>
      <a
        href="#how-it-works"
        class="font-headline font-bold text-base px-7 py-3.5 rounded-md border-2 border-black bg-yellow-50 text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none"
      >
        How it works
      </a>
    </div>
  </div>

  <%# An illustration of a search turning into a chat. The people are made up, so it's labelled. %>
  <div class="relative" role="img" aria-label="Example: someone applies to a partner search to learn Rust, and the two of them agree to try a small project together.">
    <div class="absolute -top-3 right-2 bg-yellow-50 text-black text-xs font-bold px-3 py-1.5 rounded-md border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] z-10">
      Example
    </div>

    <div class="bg-white border-2 border-black rounded-xl p-5 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
      <p class="text-xs font-bold text-gray-600 uppercase tracking-widest mb-2">Partner search</p>
      <p class="font-display font-bold text-xl text-black mb-3 leading-snug">Learn Rust by building a small CLI</p>
      <div class="flex gap-2 flex-wrap">
        <span class="bg-purple text-white text-xs font-bold px-2 py-1 rounded border border-black">Rust</span>
        <span class="bg-orange text-black text-xs font-bold px-2 py-1 rounded border border-black">1&ndash;3 months</span>
      </div>
    </div>

    <div class="flex flex-col gap-3 mt-5">
      <div class="self-start max-w-[85%] bg-yellow-50 border-2 border-black rounded-xl p-3.5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <p class="font-display font-bold text-sm text-black mb-1">Alex</p>
        <p class="text-sm text-gray-700 leading-relaxed">I'm halfway through the Rust book too. Want to build something together?</p>
      </div>
      <div class="self-end max-w-[85%] bg-white border-2 border-black rounded-xl p-3.5 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <p class="font-display font-bold text-sm text-black mb-1">Sara</p>
        <p class="text-sm text-gray-700 leading-relaxed">Yes. Evenings work best for me. Shall we start with a small project?</p>
      </div>
      <div class="self-center bg-green text-black text-sm font-bold px-4 py-2 rounded-md border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
        You're partners. Workspace opened.
      </div>
    </div>
  </div>
</section>

<%# TECH MARQUEE — decorative: whatever you're learning %>
<div class="relative flex w-full overflow-x-hidden border-b-4 border-black bg-black" aria-hidden="true">
  <div class="animate-marquee motion-reduce:animate-none whitespace-nowrap py-6 flex">
    <% tech_icons.each do |icon| %>
      <span class="flex justify-center items-center bg-orange border-2 border-orange/50 rounded-xl p-2 w-14 h-14 md:w-16 md:h-16 shadow-[3px_3px_0px_0px_rgba(255,255,255,0.1)] mx-3 text-3xl text-white">
        <i class="devicon-<%= icon %>"></i>
      </span>
    <% end %>
  </div>
  <div class="absolute top-0 animate-marquee2 motion-reduce:hidden whitespace-nowrap py-6 flex">
    <% tech_icons.each do |icon| %>
      <span class="flex justify-center items-center bg-orange border-2 border-orange/50 rounded-xl p-2 w-14 h-14 md:w-16 md:h-16 mx-3 text-3xl text-white">
        <i class="devicon-<%= icon %>"></i>
      </span>
    <% end %>
  </div>
</div>

<%# STRIP %>
<div class="border-b-4 border-black px-6 md:px-24 py-8 grid grid-cols-2 md:grid-cols-4 gap-6 bg-yellow-50">
  <% [["Free", "during beta"], ["Talk", "before you commit"], ["Your pace,", "your schedule"], ["Help", "shape the roadmap"]].each do |first, second| %>
    <p class="text-center font-display font-extrabold text-lg md:text-xl tracking-tight text-black">
      <%= first %> <span class="text-purple"><%= second %></span>
    </p>
  <% end %>
</div>

<%# WHY — the problem, in the reader's terms %>
<section class="px-6 md:px-16 lg:px-24 py-16 md:py-24 grid md:grid-cols-2 gap-12 md:gap-20 items-center border-b-4 border-black bg-white">
  <div>
    <span class="text-xs font-bold text-purple uppercase tracking-widest block mb-3">Why a partner</span>
    <h2 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight leading-none mb-5">
      Learning alone is easy to quit
    </h2>
    <p class="text-gray-600 leading-relaxed text-base mb-4 max-w-md">
      When nobody's expecting you, it's easy to skip tonight, then tomorrow. Someone learning alongside you makes it harder to drift, and a lot more fun.
    </p>
    <p class="text-gray-600 leading-relaxed text-base mb-6 max-w-md">
      The hard part is finding that person, then keeping it going after the first week. <span class="font-bold text-black">Pairin</span> is built for both.
    </p>
    <div class="flex flex-wrap gap-2">
      <% ["Any language or stack", "All levels welcome", "Self-taught, students, working devs"].each do |chip| %>
        <span class="border-2 border-black rounded-full px-4 py-1.5 text-sm font-bold bg-yellow-50 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"><%= chip %></span>
      <% end %>
    </div>
  </div>

  <div class="flex justify-center">
    <div class="border-2 border-black rounded-2xl bg-yellow-50 p-8 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] w-full max-w-sm">
      <%= image_tag "collaborate.svg", alt: "", class: "w-full h-auto" %>
    </div>
  </div>
</section>

<%# HOW IT WORKS — one path, four steps %>
<section id="how-it-works" class="px-6 md:px-16 lg:px-24 py-16 md:py-24 bg-yellow-50 border-b-4 border-black">
  <div class="mb-12">
    <span class="text-xs font-bold text-purple uppercase tracking-widest block mb-3">How it works</span>
    <h2 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight leading-none">
      Talk first, then commit
    </h2>
  </div>

  <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 list-none">
    <% [
      { title: "Post a search", text: "Say what you want to learn and for how long: a few weeks, 1–3 months or open-ended. Or browse other people's searches and apply." },
      { title: "Talk first", text: "The first reply opens a chat, so you can see whether it fits. No time slots and no intro calls." },
      { title: "Both say yes", text: "When you're ready, one of you proposes and the other confirms. If it isn't a fit, Not a match ends the chat." },
      { title: "Keep going", text: "You get a private Workspace with your chat and an optional goal. You two decide how and when to work together." },
    ].each_with_index do |step, i| %>
      <li class="bg-white border-2 border-black rounded-xl p-5 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
        <span class="inline-flex items-center justify-center w-9 h-9 rounded-md bg-orange border-2 border-black font-display font-extrabold text-black mb-4"><%= i + 1 %></span>
        <h3 class="font-display font-bold text-lg text-black mb-2 leading-snug"><%= step[:title] %></h3>
        <p class="text-gray-600 text-sm leading-relaxed"><%= step[:text] %></p>
      </li>
    <% end %>
  </ol>
</section>

<%# WORKSPACE — what you get after committing. Mirrors the real page; the people are made up, so it's labelled. %>
<section id="workspace" class="px-6 md:px-16 lg:px-24 py-16 md:py-24 grid md:grid-cols-2 gap-12 md:gap-20 items-center bg-white border-b-4 border-black">
  <div>
    <span class="text-xs font-bold text-purple uppercase tracking-widest block mb-3">The Workspace</span>
    <h2 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight leading-none mb-5">
      A private place for the two of you
    </h2>
    <p class="text-gray-600 leading-relaxed text-base mb-6 max-w-md">
      Once you both say yes, you get a Workspace to keep going in. It's where a good first chat turns into a habit.
    </p>
    <ul class="flex flex-col gap-4 max-w-md list-none">
      <% [
        ["Your chat carries on", "Everything you've said so far stays in one place, and you pick up where you left off."],
        ["A shared goal, if you want one", "Write down what you're working towards. Either of you can change it."],
        ["A weekly check-in", "Once a week, we email to ask whether you worked together. It takes one click, and either answer is fine."],
        ["A clear commitment", "See how long each of you signed up for, so nobody has to guess."],
      ].each do |title, body| %>
        <li class="border-l-4 border-orange pl-4">
          <h3 class="font-display font-bold text-base text-black mb-1 leading-snug"><%= title %></h3>
          <p class="text-gray-600 text-sm leading-relaxed"><%= body %></p>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="relative" role="img" aria-label="Example Workspace for two partners: a shared goal, their chat, a tick for each week they worked together, and how long each of them committed to.">
    <div class="absolute -top-3 right-2 bg-yellow-50 text-black text-xs font-bold px-3 py-1.5 rounded-md border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] z-10">
      Example
    </div>

    <div class="bg-yellow-50 border-2 border-black rounded-2xl p-4 md:p-5 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] flex flex-col gap-4">
      <div>
        <p class="text-xs font-bold text-purple uppercase tracking-widest">Workspace</p>
        <p class="font-display font-extrabold text-2xl text-black leading-tight">You and Sara</p>
      </div>

      <div class="bg-purple text-white border-2 border-black rounded-xl px-4 py-3 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
        <p class="text-xs font-bold uppercase tracking-wide">Working towards</p>
        <p class="font-bold">Ship a small CLI in Rust</p>
      </div>

      <div class="bg-white border-2 border-black rounded-xl p-4 flex flex-col gap-2">
        <p class="font-bold text-sm text-black">Chat</p>
        <p class="self-start max-w-[85%] bg-yellow-50 border-2 border-black rounded-lg px-3 py-2 text-sm text-gray-700">I got the argument parsing working.</p>
        <p class="self-end max-w-[85%] bg-orange border-2 border-black rounded-lg px-3 py-2 text-sm text-black">Nice. Same time on Thursday?</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-white border-2 border-black rounded-xl p-4">
          <p class="font-bold text-sm text-black mb-2">Check-ins</p>
          <div class="flex gap-1">
            <% [["W1", true], ["W2", true], ["W3", false]].each do |week, worked| %>
              <span class="flex-1 text-center rounded-md border-2 border-black py-1 text-xs font-bold text-black <%= worked ? "bg-green" : "bg-white" %>"><%= week %><%= " ✓" if worked %></span>
            <% end %>
          </div>
        </div>
        <div class="bg-white border-2 border-black rounded-xl p-4">
          <p class="font-bold text-sm text-black mb-2">Committed to</p>
          <p class="text-sm text-black">You: 1&ndash;3 months</p>
          <p class="text-sm text-black">Sara: 1&ndash;3 months</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%# THE REST %>
<section class="px-6 md:px-16 lg:px-24 py-16 md:py-24 bg-yellow-50 border-b-4 border-black">
  <div class="mb-10">
    <span class="text-xs font-bold text-purple uppercase tracking-widest block mb-3">Also built in</span>
    <h2 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight leading-none">
      A few other things
    </h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <% [
      { title: "Find the right people", body: "Filter searches by tag, commitment, level and language." },
      { title: "A link to invite someone", body: "Know someone who'd be a good fit? Send them a link to your search, even if they aren't on Pairin yet." },
      { title: "An easy way out", body: "Either of you can end a partnership. We'll tell your partner kindly, and the Workspace stays readable." },
      { title: "You stay in control", body: "Block or report someone if you need to, and unsubscribe from the emails you don't want." },
    ].each do |feature| %>
      <div class="bg-white border-2 border-black rounded-xl p-5 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
        <h3 class="font-display font-bold text-base text-black mb-2 leading-snug"><%= feature[:title] %></h3>
        <p class="text-gray-600 text-sm leading-relaxed"><%= feature[:body] %></p>
      </div>
    <% end %>
  </div>
</section>

<%# FAQ %>
<section id="faq" class="px-6 md:px-16 lg:px-24 py-16 md:py-24 bg-white border-b-4 border-black">
  <div class="mb-10">
    <span class="text-xs font-bold text-purple uppercase tracking-widest block mb-3">FAQ</span>
    <h2 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight leading-none">
      Questions, answered
    </h2>
  </div>

  <div class="flex flex-col gap-4 max-w-2xl">
    <% faqs.each do |faq| %>
      <details class="group bg-yellow-50 border-2 border-black rounded-xl p-5 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
        <summary class="font-display font-bold text-base text-black cursor-pointer list-none flex items-center justify-between gap-4">
          <%= faq[:q] %>
          <span class="text-xl leading-none group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
        </summary>
        <p class="text-gray-600 text-sm leading-relaxed mt-3"><%= faq[:a] %></p>
      </details>
    <% end %>
  </div>
</section>

<%# CTA %>
<section class="px-6 md:px-16 lg:px-24 py-16 md:py-24 bg-black border-b-4 border-black grid md:grid-cols-2 gap-12 md:gap-20 items-center">
  <div>
    <h2 class="font-display font-extrabold text-5xl md:text-6xl tracking-tight leading-none mb-5 text-white">
      Find someone to <span class="text-orange">learn with</span>
    </h2>
    <p class="text-gray-300 leading-relaxed text-base mb-8 max-w-sm">
      Posting a search takes about a minute. Pairin is built by one person, and everyone who joins now gets a say in where it goes.
    </p>
    <a
      href="/users/sign_up"
      class="inline-block font-headline font-bold text-base px-7 py-3.5 rounded-md border-2 border-black bg-orange text-black shadow-[4px_4px_0px_0px_rgba(255,255,255,0.2)] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none"
    >
      Post your search &rarr;
    </a>
  </div>

  <div class="flex justify-center md:justify-end">
    <%= image_tag "start.svg", alt: "", class: "w-64 md:w-80 h-auto" %>
  </div>
</section>

<%# FOOTER %>
<footer class="bg-black px-6 md:px-16 lg:px-24 pt-12 pb-6 border-b-4 border-black">
  <div class="grid md:grid-cols-3 gap-10 pb-10 border-b border-white/10 mb-6">
    <div>
      <div class="flex items-center gap-2 mb-3">
        <%= image_tag "logo.svg", alt: "Pairin logo", class: "h-8 invert" %>
        <span class="font-display font-bold text-white text-base tracking-tight">pairin</span>
      </div>
      <p class="text-white/40 text-sm leading-relaxed max-w-xs">
        Find a partner to learn programming with, and keep going.
      </p>
    </div>

    <div>
      <h5 class="text-white/35 text-xs font-bold uppercase tracking-widest mb-4">Platform</h5>
      <ul class="flex flex-col gap-2.5">
        <li>
          <a href="/users/sign_up" class="text-white/60 text-sm hover:text-white transition-colors font-medium">
            Find a partner
          </a>
        </li>
        <li>
          <a href="/users/sign_up" class="text-white/60 text-sm hover:text-white transition-colors font-medium">
            Sign up
          </a>
        </li>
        <li>
          <a href="/users/sign_in" class="text-white/60 text-sm hover:text-white transition-colors font-medium">
            Log in
          </a>
        </li>
        <li>
          <a href="#how-it-works" class="text-white/60 text-sm hover:text-white transition-colors font-medium">
            How it works
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h5 class="text-white/35 text-xs font-bold uppercase tracking-widest mb-4">Company</h5>
      <ul class="flex flex-col gap-2.5">
        <li>
          <%= link_to "Privacy policy", privacy_path, class: "text-white/60 text-sm hover:text-white transition-colors font-medium" %>
        </li>
        <li>
          <%= link_to "Terms of service", terms_path, class: "text-white/60 text-sm hover:text-white transition-colors font-medium" %>
        </li>
      </ul>
    </div>
  </div>

  <div class="flex items-center justify-between flex-wrap gap-3">
    <p class="text-white/25 text-xs">&copy; <%= Date.current.year %> Pairin. All rights reserved.</p>
    <p class="text-white/25 text-xs">made by Manufaktura Koda</p>
  </div>
</footer>
