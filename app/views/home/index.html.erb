<%# ════════════════════════════════════════════════════════ %>
<%# HERO — two-column: copy left, live card stack right    %>
<%# ════════════════════════════════════════════════════════ %>
<section class="px-6 md:px-16 lg:px-24 pt-12 pb-10 md:pt-20 md:pb-20 grid md:grid-cols-2 gap-12 md:gap-20 items-center border-b-4 border-black">

  <div>
    <div class="inline-flex items-center gap-2 bg-white border-2 border-black rounded-full px-4 py-1.5 text-sm font-bold mb-6 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
      <span class="live-dot"></span>
      Now in beta · Accepting members
    </div>

    <h1 class="font-display font-extrabold text-6xl md:text-7xl lg:text-8xl leading-none tracking-tight mb-5">
      It's<br>
      <span class="bg-orange text-white px-2 rounded-md inline-block leading-tight">PAIRIN</span><br>
      time!
    </h1>

    <p class="text-gray-500 text-lg leading-relaxed max-w-sm mb-8">
      Find a pair programming partner or coding buddy — fast. Match on stack, timezone, and goals.
    </p>

    <div class="flex flex-wrap gap-3">
      <%= link_to new_user_registration_path,
          class: "font-headline font-bold text-base px-7 py-3.5 rounded-md border-2 border-black bg-purple text-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none" do %>
        Sign up free →
      <% end %>
      <%= link_to "#how-it-works",
          class: "font-headline font-bold text-base px-7 py-3.5 rounded-md border-2 border-black bg-yellow-50 text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none" do %>
        How it works
      <% end %>
    </div>
  </div>

  <%# Profile card stack (visual mockup) %>
  <div class="relative hidden md:block">
    <div class="absolute -top-3 right-2 bg-green text-white text-xs font-bold px-3 py-1.5 rounded-md border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] z-10">
      🎉 New match!
    </div>
    <div class="flex flex-col gap-3 mt-4">
      <% [
        { name: "Alex M.",  emoji: "🧑‍💻", tags: ["React", "TypeScript"], level: "Mid-level" },
        { name: "Sara K.",  emoji: "👩‍💻", tags: ["Python", "Django"],    level: "Senior"    },
        { name: "Luca R.",  emoji: "🧑‍💻", tags: ["Rails", "PostgreSQL"], level: "Junior"    }
      ].each do |dev| %>
        <div class="bg-white border-2 border-black rounded-xl p-3.5 flex items-center gap-3 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] transition-all">
          <div class="w-10 h-10 rounded-lg bg-purple/10 border-2 border-black flex items-center justify-center text-lg flex-shrink-0">
            <%= dev[:emoji] %>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-display font-bold text-sm text-black"><%= dev[:name] %></p>
            <div class="flex gap-1 mt-1 flex-wrap">
              <% dev[:tags].each do |tag| %>
                <span class="bg-purple text-white text-xs font-bold px-2 py-0.5 rounded border border-black"><%= tag %></span>
              <% end %>
              <span class="bg-orange text-white text-xs font-bold px-2 py-0.5 rounded border border-black"><%= dev[:level] %></span>
            </div>
          </div>
          <button class="flex-shrink-0 bg-purple text-white text-xs font-bold px-3 py-2 rounded-md border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-none transition-all">Connect</button>
        </div>
      <% end %>
    </div>
  </div>

</section>


<%# ════════════════════════════════════════════════════════ %>
<%# TECH MARQUEE — dark background, shows supported stacks  %>
<%# ════════════════════════════════════════════════════════ %>
<div class="relative flex w-full overflow-x-hidden border-b-4 border-black bg-black">
  <div class="animate-marquee whitespace-nowrap py-6 flex">
    <% %w[rails-plain-wordmark c-plain clojure-line csharp-plain css3-plain docker-plain dot-net-plain flutter-plain go-original-wordmark javascript-plain kotlin-plain kubernetes-plain ruby-plain rust-plain python-plain typescript-plain vuejs-plain react-original].each do |icon| %>
      <span class="flex justify-center items-center bg-orange border-2 border-orange/50 rounded-xl p-2 w-14 h-14 md:w-16 md:h-16 shadow-[3px_3px_0px_0px_rgba(255,255,255,0.1)] mx-3 text-3xl text-white">
        <i class="devicon-<%= icon %>"></i>
      </span>
    <% end %>
  </div>
  <div class="absolute top-0 animate-marquee2 whitespace-nowrap py-6 flex" aria-hidden="true">
    <% %w[rails-plain-wordmark c-plain clojure-line csharp-plain css3-plain docker-plain dot-net-plain flutter-plain go-original-wordmark javascript-plain kotlin-plain kubernetes-plain ruby-plain rust-plain python-plain typescript-plain vuejs-plain react-original].each do |icon| %>
      <span class="flex justify-center items-center bg-orange border-2 border-orange/50 rounded-xl p-2 w-14 h-14 md:w-16 md:h-16 mx-3 text-3xl text-white">
        <i class="devicon-<%= icon %>"></i>
      </span>
    <% end %>
  </div>
</div>


<%# ════════════════════════════════════════════════════════ %>
<%# STATS STRIP                                             %>
<%# ════════════════════════════════════════════════════════ %>
<div class="border-b-4 border-black px-6 md:px-24 py-8 grid grid-cols-2 md:grid-cols-4 gap-6 bg-yellow-50">
  <div class="text-center">
    <p class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-black">500<span class="text-orange">+</span></p>
    <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-1.5">Developers</p>
  </div>
  <div class="text-center">
    <p class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-black">300<span class="text-orange">+</span></p>
    <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-1.5">Pairings done</p>
  </div>
  <div class="text-center">
    <p class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-black">40<span class="text-orange">+</span></p>
    <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-1.5">Technologies</p>
  </div>
  <div class="text-center">
    <p class="font-display font-extrabold text-4xl md:text-5xl tracking-tight text-black">4.9<span class="text-orange">★</span></p>
    <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-1.5">Session rating</p>
  </div>
</div>


<%# ════════════════════════════════════════════════════════ %>
<%# ABOUT — split layout: text left, illustration right     %>
<%# ════════════════════════════════════════════════════════ %>
<section class="px-6 md:px-16 lg:px-24 py-16 md:py-24 grid md:grid-cols-2 gap-12 md:gap-20 items-center border-b-4 border-black bg-white">

  <div>
    <span class="text-xs font-bold text-orange uppercase tracking-widest block mb-3">What is Pairin?</span>
    <h2 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight leading-none mb-5">
      Your coding<br>partner is<br>out there
    </h2>
    <p class="text-gray-500 leading-relaxed text-base mb-6 max-w-md">
      <span class="font-bold text-black">Pairin.dev</span> is a community of developers connecting for pair programming and collaboration. Whether you need a coding buddy or a full project partner, you'll find the right match here.
    </p>
    <div class="flex flex-wrap gap-2">
      <% ["Match by tech stack", "Filter by timezone", "Set experience level", "All levels welcome"].each do |chip| %>
        <span class="border-2 border-black rounded-full px-4 py-1.5 text-sm font-bold bg-yellow-50 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"><%= chip %></span>
      <% end %>
    </div>
  </div>

  <div class="relative flex justify-center">
    <div class="border-2 border-black rounded-2xl bg-yellow-50 p-8 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] w-full max-w-sm">
      <%= image_tag "collaborate.svg", alt: "Programmers collaborating", class: "w-full h-auto" %>
    </div>
    <div class="absolute -top-4 -right-2 bg-white border-2 border-black rounded-xl px-3 py-2 text-sm font-bold shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
      ✅ Perfect match found!
    </div>
    <div class="absolute -bottom-4 -left-2 bg-purple text-white border-2 border-black rounded-xl px-3 py-2 text-xs font-bold shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
      💬 React · TypeScript · EU
    </div>
  </div>

</section>


<%# ════════════════════════════════════════════════════════ %>
<%# HOW IT WORKS — 3-col grid of 6 step cards              %>
<%# ════════════════════════════════════════════════════════ %>
<section id="how-it-works" class="px-6 md:px-16 lg:px-24 py-16 md:py-24 bg-yellow-50 border-b-4 border-black">

  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12">
    <div>
      <span class="text-xs font-bold text-purple uppercase tracking-widest block mb-3">How it works</span>
      <h2 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight leading-none">
        Six steps to<br>your perfect pair
      </h2>
    </div>
    <p class="text-gray-500 text-sm leading-relaxed max-w-xs md:text-right">
      Whether you're posting a request or looking for one — the process takes just minutes.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-10 mb-8">

    <%# Lane — Posting %>
    <div>
      <div class="flex items-center gap-2 mb-5">
        <span class="w-3 h-3 rounded-full bg-purple border-2 border-black shrink-0" aria-hidden="true"></span>
        <h3 class="font-display font-bold text-xs uppercase tracking-widest text-purple">If you're posting</h3>
      </div>

      <div class="relative flex flex-col gap-5 pl-6">
        <div class="absolute left-0 top-2 bottom-2 w-0.5 bg-purple/20" aria-hidden="true"></div>

        <%# Step 1 %>
        <div class="relative bg-white border-2 border-black rounded-xl p-5 overflow-hidden shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all">
          <span class="absolute -top-3 right-2 font-display font-extrabold text-6xl text-purple/10 select-none leading-none" aria-hidden="true">01</span>
          <h4 class="relative font-display font-bold text-lg text-black mb-2 leading-snug">Post your programming request</h4>
          <p class="relative text-gray-500 text-sm leading-relaxed">Share your project or learning goal. Specify your stack, when you're free, and what you're looking for in a partner.</p>
        </div>

        <%# Step 2 %>
        <div class="relative bg-white border-2 border-black rounded-xl p-5 overflow-hidden shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all">
          <span class="absolute -top-3 right-2 font-display font-extrabold text-6xl text-purple/10 select-none leading-none" aria-hidden="true">02</span>
          <h4 class="relative font-display font-bold text-lg text-black mb-2 leading-snug">Review received applications</h4>
          <p class="relative text-gray-500 text-sm leading-relaxed">Browse the applicants and find the right fit for your project. The perfect coding companion is just around the corner.</p>
        </div>
      </div>
    </div>

    <%# Lane — Searching %>
    <div>
      <div class="flex items-center gap-2 mb-5">
        <span class="w-3 h-3 rounded-full bg-orange border-2 border-black shrink-0" aria-hidden="true"></span>
        <h3 class="font-display font-bold text-xs uppercase tracking-widest text-orange">If you're searching</h3>
      </div>

      <div class="relative flex flex-col gap-5 pl-6">
        <div class="absolute left-0 top-2 bottom-2 w-0.5 bg-orange/20" aria-hidden="true"></div>

        <%# Step 1 %>
        <div class="relative bg-white border-2 border-black rounded-xl p-5 overflow-hidden shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all">
          <span class="absolute -top-3 right-2 font-display font-extrabold text-6xl text-orange/10 select-none leading-none" aria-hidden="true">01</span>
          <h4 class="relative font-display font-bold text-lg text-black mb-2 leading-snug">Search for open requests</h4>
          <p class="relative text-gray-500 text-sm leading-relaxed">Browse the community's requests. Filter by technology, time zone, and experience level to find the perfect match.</p>
        </div>

        <%# Step 2 %>
        <div class="relative bg-white border-2 border-black rounded-xl p-5 overflow-hidden shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all">
          <span class="absolute -top-3 right-2 font-display font-extrabold text-6xl text-orange/10 select-none leading-none" aria-hidden="true">02</span>
          <h4 class="relative font-display font-bold text-lg text-black mb-2 leading-snug">Express your interest</h4>
          <p class="relative text-gray-500 text-sm leading-relaxed">Found a great request? Reach out and send a compelling message. Tell them why you're the right partner.</p>
        </div>

        <%# Step 3 %>
        <div class="relative bg-white border-2 border-black rounded-xl p-5 overflow-hidden shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all">
          <span class="absolute -top-3 right-2 font-display font-extrabold text-6xl text-orange/10 select-none leading-none" aria-hidden="true">03</span>
          <h4 class="relative font-display font-bold text-lg text-black mb-2 leading-snug">Await approval</h4>
          <p class="relative text-gray-500 text-sm leading-relaxed">After applying, wait for the requester's confirmation. Get ready for the session — it's just around the corner.</p>
        </div>
      </div>
    </div>

  </div>

  <%# Convergence arrow — both lanes flow into the shared final step %>
  <div class="flex justify-center" aria-hidden="true">
    <svg width="20" height="28" viewBox="0 0 20 28" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 0V20M10 20L2 12M10 20L18 12" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <%# Step 6 — Both flows converge %>
  <div class="relative bg-white border-2 border-black border-t-4 border-t-green rounded-xl p-6 md:p-8 overflow-hidden shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all text-center">
    <span class="inline-flex items-center gap-2 text-xs font-bold text-green uppercase tracking-widest mb-3">
      <span class="w-2.5 h-2.5 rounded-full bg-green border border-black" aria-hidden="true"></span> Everyone
    </span>
    <h3 class="font-display font-bold text-xl text-black mb-2 leading-snug">Start pairing! 🎉</h3>
    <p class="text-gray-500 text-sm leading-relaxed max-w-md mx-auto">Confirm your coding partner and get ready to build together. The perfect collaboration is one click away.</p>
  </div>

</section>


<%# ════════════════════════════════════════════════════════ %>
<%# CTA — dark section: "Start pairin'"                     %>
<%# ════════════════════════════════════════════════════════ %>
<section class="px-6 md:px-16 lg:px-24 py-16 md:py-24 bg-black border-b-4 border-black grid md:grid-cols-2 gap-12 md:gap-20 items-center">

  <div>
    <span class="text-xs font-bold text-gray-500 uppercase tracking-widest block mb-4">Ready?</span>
    <h2 class="font-display font-extrabold text-5xl md:text-6xl tracking-tight leading-none mb-5 text-white">
      Time to<br><span class="text-orange">start pairin'</span>
    </h2>
    <p class="text-gray-400 leading-relaxed text-base mb-8 max-w-sm">
      Join hundreds of developers already building together. Your next coding partner is waiting.
    </p>
    <div class="flex flex-wrap gap-3">
      <%= link_to new_user_registration_path,
          class: "font-headline font-bold text-base px-7 py-3.5 rounded-md border-2 border-black bg-orange text-white shadow-[4px_4px_0px_0px_rgba(255,255,255,0.2)] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none" do %>
        Find a partner →
      <% end %>
      <%= link_to pair_requests_path,
          class: "font-headline font-bold text-base px-7 py-3.5 rounded-md border-2 border-white/20 text-white hover:bg-white/10 hover:border-white/40 transition-all" do %>
        Post a request
      <% end %>
    </div>
  </div>

  <div class="flex justify-center md:justify-end">
    <%= image_tag "start.svg", alt: "Programmer on the road to success", class: "w-64 md:w-80 h-auto" %>
  </div>

</section>


<%# ════════════════════════════════════════════════════════ %>
<%# COMMUNITY — purple section                              %>
<%# ════════════════════════════════════════════════════════ %>
