<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Pairin - Find a coding buddy or pair programming partner to learn with" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "Post what you want to learn, talk to the people who apply, and commit when it&#39;s a good fit. Find a coding buddy or pair programming partner on Pairin. Free during beta." %>" />
    <link rel="canonical" href="<%= canonical_url %>">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Pairin">
    <meta property="og:title" content="Pairin - Find a coding buddy or pair programming partner to learn with">
    <meta property="og:description" content="Post what you want to learn, talk to the people who apply, and commit when it&#39;s a good fit. Find a coding buddy or pair programming partner on Pairin. Free during beta.">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= image_url('logo.svg') %>">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Pairin - Find a coding buddy or pair programming partner to learn with">
    <meta name="twitter:description" content="Post what you want to learn, talk to the people who apply, and commit when it&#39;s a good fit. Find a coding buddy or pair programming partner on Pairin. Free during beta.">
    <meta name="twitter:image" content="<%= image_url('logo.svg') %>">

    <script type="application/ld+json">
      <%== {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Pairin",
        "url": root_url,
        "logo": image_url("logo.svg"),
        "description": "Pairin helps people learning programming find a steady partner."
      }.to_json %>
    </script>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= vite_stylesheet_tag 'application', data: { 'turbo-track': 'reload' } %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.15.1/devicon.min.css">

    <%= favicon_link_tag asset_path('logo.svg') %>

    <%= render "layouts/posthog" %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
