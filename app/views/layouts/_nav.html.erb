<input type="checkbox" id="drawer-overlay" class="drawer-toggle" />

<label for="drawer-overlay" class="btn btn-primary mt-2 ml-2">Menu</label>
<label class="overlay" for="drawer-left"></label>
<div class="drawer">
	<div class="drawer-content pt-10 flex flex-col h-full">
    <label for="drawer-overlay" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</label>
		<nav class="menu bg-gray-2 p-4 rounded-md">
      <section class="menu-section">
        <ul class="menu-items">
          <li class="menu-item text-2xl"><%= link_to "Community", activities_path %></li>
          <li class="menu-item text-2xl"><%= link_to "Search", pair_requests_path %></li>
          <li class="menu-item text-2xl"><%= link_to "Applied", users_offers_path %></li>
          <li class="menu-item text-2xl"><%= link_to "Pairin requests", users_pair_requests_path %></li>
          <li class="menu-item text-2xl"><%= link_to "Sessions", sessions_path %></li>
        </ul>
      </section>
      <div class="divider my-0"></div>
      <section class="menu-section">
        <span class="menu-title">Profile</span>
        <ul class="menu-items">
          <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete } %>
        </ul>
      </section>
    </nav>
	</div>
</div>


<div data-controller="home" class="md:hidden w-full">
  <div data-controller="reveal relative">
    <button data-action="click->reveal#toggle" type="button" class="absolute top-2 right-2">
      <%= image_tag "hamburger.svg", class: "w-8 h-8" %>
    </button>

    <div data-reveal-target="item" class="hidden w-full">
      <div class="border-b-4 border-black h-16 flex justify-center items-center cursor-pointer transition-all hover:translate-x-[3px] hover:translate-y-[3px]">
        <%= image_tag "logo.svg", class: "w-12 h-12" %>
      </div>
      <div class="border-b-4 border-black h-16 flex justify-center items-center cursor-pointer transition-all hover:translate-x-[3px] hover:translate-y-[3px]">
        <%= link_to "Activities", activities_path %>
      </div>
      <div class="border-b-4 border-black h-16 flex justify-center items-center cursor-pointer transition-all hover:translate-x-[3px] hover:translate-y-[3px]">
        <%= link_to "Pair Requests", pair_requests_path %>
      </div>
      <div class="border-b-4 border-black h-16 flex justify-center items-center cursor-pointer transition-all hover:translate-x-[3px] hover:translate-y-[3px]">
        <%= link_to "Offers", users_offers_path %>
      </div>
      <div class="border-b-4 border-black h-16 flex justify-center items-center cursor-pointer transition-all hover:translate-x-[3px] hover:translate-y-[3px]">
        <%= link_to "You pair requests", users_pair_requests_path %>
      </div>
      <div class="border-b-4 border-black h-16 flex justify-center items-center cursor-pointer transition-all hover:translate-x-[3px] hover:translate-y-[3px]">
        <%= link_to "Activity", root_path %>
      </div>
      <div class="border-b-4 border-black h-16 flex justify-center items-center cursor-pointer transition-all hover:translate-x-[3px] hover:translate-y-[3px]">
        <%= link_to "Profile", profile_path(current_user.id) %>
      </div>
      <div class="border-b-4 border-black h-16 flex justify-center items-center cursor-pointer transition-all hover:translate-x-[3px] hover:translate-y-[3px]">
        <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete } %>
      </div>
    </div>
  </div>
</div>
