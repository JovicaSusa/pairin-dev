<% content_for :title, "Pause your partner search - Pairin" %>

<div class="px-6 md:px-16 lg:px-24 py-16 md:py-20 max-w-2xl mx-auto">
  <a href="<%= root_path %>" class="text-sm font-bold text-purple hover:underline">&larr; Back to Pairin</a>

  <h1 class="font-display font-extrabold text-4xl tracking-tight leading-none mt-6 mb-6">
    <% if @pair_request.paused? %>
      Your partner search is paused
    <% else %>
      Pause your partner search?
    <% end %>
  </h1>

  <div class="rounded-xl border-2 border-black bg-white p-6">
    <p class="text-sm text-gray-500 mb-1">Your partner search</p>
    <p class="font-bold"><%= @pair_request.subject %></p>
  </div>

  <% if @pair_request.paused? %>
    <p class="mt-8 text-gray-700">It's hidden from others, and nobody new can apply. You can switch it back on from <a href="<%= users_pair_requests_path %>" class="text-purple font-bold">your partner searches</a>.</p>
  <% else %>
    <%= button_to "Pause this search", request_pause_path(token: params[:token]), class: "mt-8 rounded-xl border-2 border-black bg-orange px-6 py-3 font-bold shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none" %>
    <p class="mt-3 text-sm text-gray-500">It'll be hidden from others, and nobody new can apply. You can still reply to anyone who already applied.</p>
  <% end %>
</div>
