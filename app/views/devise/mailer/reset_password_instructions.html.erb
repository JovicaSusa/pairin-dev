<%= render layout: "devise/mailer/frame", locals: { heading: "Reset your Pairin password", preheader: "Choose a new password for your Pairin account." } do %>
  <p style="margin: 0; line-height: 24px">
    We got a request to reset the password for your Pairin account. Choose a new one with the button below.
  </p>
  <p style="margin: 32px 0; text-align: center">
    <a href="<%= edit_password_url(@resource, reset_password_token: @token) %>" style="display: inline-block; border: 2px solid #000001; border-radius: 12px; background-color: #FF8B37; padding: 12px 24px; font-weight: 600; color: #000001; text-decoration: none">Reset password</a>
  </p>
  <p style="margin: 0; font-size: 14px; line-height: 20px; color: #475569">
    This link works for <%= Devise.reset_password_within.in_hours.to_i %> hours. If you didn't ask for this, you can ignore this email and your password will stay the same.
  </p>
<% end %>
