<div class="flex flex-col items-center px-4">
  <div class="w-full md:w-2/6">
    <h2 class="text-center border-b-4 border-black border-dashed text-4xl font-bold mt-8 pb-4 mb-4">Sign up</h2>

    <%= simple_form_for(
      resource,
      as: resource_name,
      url: registration_path(resource_name),
      html: { class: "flex flex-col items-center w-full" }
    ) do |f| %>
      <div class="form-inputs w-full mt-4 md:mt-6">
        <%= f.input :email,
                    required: true,
                    autofocus: true,
                    outter_html: {
                      class: ""
                    },
                    input_html: {
                      autocomplete: "email",
                      class: "input"
                    } %>
        <%= f.input :password,
                    required: true,
                    label_html: {
                      class: "block mt-4"
                    },
                    outter_html: {
                      class: ""
                    },
                    input_html: {
                      autocomplete: "new-password",
                      class: "input"
                    } %>
        <%= f.input :password_confirmation,
                    required: true,
                    outter_html: {
                      class: ""
                    },
                    label_html: {
                      class: "block mt-4"
                    },
                    input_html: {
                      autocomplete: "new-password",
                      class: "input"
                    } %>
      </div>

      <input type="text" name="bot_trap" class="opacity-0 absolute top-0 left-0 -z-10 h-0 w-0" />

      <%= f.input :timezone, as: :hidden, input_html: { data: { controller: "register-timezone" } } %>

      <div class="form-actions mt-6">
        <%= f.button :submit, "Sign up", class: "mt-6 btn btn-outline-primary"  %>
      </div>
    <% end %>

    <div class="mt-12">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
