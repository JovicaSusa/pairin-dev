<% content_for :title, "#{@post.title} - Pairin" %>
<% content_for :description, @post.description %>
<% content_for :og_type, "article" %>
<%= render "blog/head" %>
<% content_for :head do %>
  <meta property="article:published_time" content="<%= @post.date.iso8601 %>">
  <meta property="article:modified_time" content="<%= @post.last_modified.iso8601 %>">
  <script type="application/ld+json">
    <%== blog_posting_json_ld(@post) %>
  </script>
<% end %>
<%= render "blog/header" %>

<main class="px-6 md:px-16 lg:px-24 py-16 md:py-20 max-w-3xl mx-auto">
  <%= link_to "← All posts", blog_path, class: "text-sm font-bold text-purple hover:underline" %>

  <article class="mt-6">
    <header class="mb-10">
      <h1 class="font-display font-extrabold text-4xl md:text-5xl tracking-tight leading-tight"><%= @post.title %></h1>
      <p class="text-gray-500 text-sm mt-4">
        Pairin team &middot;
        <time datetime="<%= @post.date.iso8601 %>"><%= @post.date.strftime("%B %-d, %Y") %></time>
        <% if @post.updated %>
          &middot; Updated <time datetime="<%= @post.updated.iso8601 %>"><%= @post.updated.strftime("%B %-d, %Y") %></time>
        <% end %>
      </p>
    </header>

    <div class="blog-prose blog-prose-lg max-w-none">
      <%= @post.html %>
    </div>
  </article>

  <%= render "blog/sign_off" %>
</main>
