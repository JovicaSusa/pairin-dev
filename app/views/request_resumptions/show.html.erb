<% content_for :title, "Turn your request back on - Pairin" %>

<div class="px-6 md:px-16 lg:px-24 py-16 md:py-20 max-w-2xl mx-auto">
  <a href="<%= root_path %>" class="text-sm font-bold text-purple hover:underline">&larr; Back to Pairin</a>

  <h1 class="font-display font-extrabold text-4xl tracking-tight leading-none mt-6 mb-6">
    <% if @pair_request.paused? %>
      Still looking for a partner?
    <% else %>
      Your request is back on
    <% end %>
  </h1>

  <div class="rounded-xl border-2 border-black bg-white p-6">
    <p class="text-sm text-gray-500 mb-1">Your request</p>
    <p class="font-bold"><%= @pair_request.subject %></p>
  </div>

  <% if @pair_request.paused? %>
    <%= button_to "Turn it back on", request_resumption_path(token: params[:token]),
          class: "mt-8 rounded-xl border-2 border-black bg-orange px-6 py-3 font-bold shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none" %>
    <p class="mt-3 text-sm text-gray-500">Others will see it again and can send offers. Offers that already expired stay expired.</p>
  <% else %>
    <p class="mt-8 text-gray-700">Others can see it and send offers again. <a href="<%= users_pair_requests_path %>" class="text-purple font-bold">See your requests</a>.</p>
  <% end %>
</div>
