<% content_for :title, "Did it happen? - Pairin" %>
<% primary = "rounded-xl border-2 border-black bg-orange px-6 py-3 font-bold shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none" %>
<% secondary = "rounded-xl border-2 border-black bg-white px-6 py-3 font-bold shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none" %>

<div class="px-6 md:px-16 lg:px-24 py-16 md:py-20 max-w-2xl mx-auto">
  <a href="<%= root_path %>" class="text-sm font-bold text-purple hover:underline">&larr; Back to Pairin</a>

  <h1 class="font-display font-extrabold text-4xl tracking-tight leading-none mt-6 mb-4">
    <%= @answer.answered? && !@choice ? "Thanks, got it" : "Did your session with #{@partner.display_name} happen?" %>
  </h1>
  <p class="mb-6 text-gray-700"><%= @starts.strftime("%A %-d %B at %H:%M") %> (<%= @answer.user.timezone %>)</p>

  <% if @choice %>
    <%= button_to "Confirm: #{@choice.capitalize}", session_answer_path(token: params[:token]), params: { answer: @choice }, class: primary %>
    <p class="mt-4 text-sm">
      <a href="<%= session_answer_path(token: params[:token]) %>" class="font-bold text-purple">Choose the other answer</a>
    </p>
  <% elsif @answer.answered? %>
    <% other = @answer.happened? ? "no" : "yes" %>
    <p class="text-gray-700">
      You said <strong><%= @answer.happened? ? "yes" : "no" %></strong>, it <%= @answer.happened? ? "happened" : "didn't happen" %>.
    </p>
    <div class="mt-6">
      <%= button_to "Change to #{other.capitalize}", session_answer_path(token: params[:token]), params: { answer: other }, class: secondary %>
    </div>
  <% else %>
    <div class="flex gap-3">
      <%= button_to "Yes", session_answer_path(token: params[:token]), params: { answer: "yes" }, class: primary %>
      <%= button_to "No", session_answer_path(token: params[:token]), params: { answer: "no" }, class: secondary %>
    </div>
  <% end %>
</div>
