<% content_for :title, "#{@search.subject} - Pairin" %>
<% poster = @search.user %>
<% first_name = poster.display_name.split.first %>

<div class="px-6 md:px-16 lg:px-24 py-16 md:py-20 max-w-2xl mx-auto">
  <a href="<%= root_path %>" class="text-sm font-bold text-purple hover:underline">&larr; Pairin</a>

  <p class="mt-6 text-xs font-bold uppercase tracking-widest text-purple">Looking for a learning partner</p>
  <h1 class="font-display font-extrabold text-4xl tracking-tight leading-none mt-2 mb-6"><%= @search.subject %></h1>

  <div class="rounded-xl border-2 border-black bg-white p-6">
    <p class="font-bold">
      <%= first_name %><% if poster.level_titleized %> &middot; <%= poster.level_titleized %><% end %>
    </p>
    <p class="mt-3 whitespace-pre-wrap text-gray-700"><%= @search.description %></p>
    <p class="mt-4 text-sm"><span class="font-bold">Commitment:</span> <%= @search.commitment_label %></p>
    <% if @search.tags.any? %>
      <p class="mt-2 text-sm"><span class="font-bold">Topics:</span> <%= @search.tags.map(&:name).to_sentence %></p>
    <% end %>
  </div>

  <% if current_user == poster %>
    <p class="mt-8 text-gray-700">This is how your partner search looks to people you share it with.</p>
  <% elsif @search.taking_applications? %>
    <div class="mt-8">
      <%= link_to "Apply to #{first_name}", public_search_apply_path(token: params[:token]), rel: "nofollow", class: "inline-block rounded-xl border-2 border-black bg-orange px-6 py-3 font-bold shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none" %>
    </div>
    <p class="mt-4 text-sm text-gray-500">
      Pairin connects people who want to learn together. You talk first, and only commit if it's a good fit.
      <% unless user_signed_in? %>It's free, and you'll need an account to apply.<% end %>
    </p>
  <% else %>
    <p class="mt-8 text-gray-700">This partner search is no longer open. <a href="<%= pair_requests_path %>" class="text-purple font-bold">See who else is looking</a>.</p>
  <% end %>
</div>
