<% content_for :title, "Application - Pairin" %>

<% offerer_name = @offer.offerer_display_name %>
<% poster_timezone = @offer.pair_request.user.timezone %>

<div class="px-6 md:px-16 lg:px-24 py-16 md:py-20 max-w-2xl mx-auto">
  <a href="<%= root_path %>" class="text-sm font-bold text-purple hover:underline">&larr; Back to Pairin</a>

  <% if flash[:alert] %>
    <p class="mt-6 rounded-xl border-2 border-black bg-red/10 p-3 font-bold"><%= flash[:alert] %></p>
  <% end %>

  <h1 class="font-display font-extrabold text-4xl tracking-tight leading-none mt-6 mb-6">
    <% case @offer.status %>
    <% when "ACCEPTED" %>
      You accepted <%= offerer_name %>'s application
    <% when "ACCEPTED OTHER" %>
      This partner search is already matched
    <% when "EXPIRED" %>
      This application has expired
    <% else %>
      <%= offerer_name %> wants to pair with you
    <% end %>
  </h1>

  <div class="rounded-xl border-2 border-black bg-white p-6">
    <p class="text-sm text-gray-500 mb-1">On your partner search</p>
    <p class="font-bold mb-4"><%= @offer.pair_request.subject %></p>

    <blockquote class="border-l-4 border-purple pl-4 mb-4"><%= @offer.message %></blockquote>

    <% if @offer.period %>
    <p>
      <span class="font-bold">Time:</span>
      <%= @offer.period.start_at.in_time_zone(poster_timezone).to_fs(:short) %>
      &ndash; <%= @offer.period.end_at.in_time_zone(poster_timezone).strftime("%H:%M") %>
      (<%= poster_timezone %>)
    </p>
    <% end %>

    <% if @offer.offerer.github_url.present? %>
      <p class="mt-2">
        <span class="font-bold">GitHub:</span>
        <%= link_to @offer.offerer.github_url, @offer.offerer.github_url, class: "text-purple font-bold underline", target: "_blank", rel: "noopener noreferrer" %>
      </p>
    <% end %>
  </div>

  <% case @offer.status %>
  <% when "PENDING" %>
    <%= button_to "Accept", offer_confirmation_path(token: params[:token]),
          class: "mt-8 rounded-xl border-2 border-black bg-orange px-6 py-3 font-bold shadow-[4px_4px_0_0_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none" %>
  <% when "ACCEPTED" %>
    <p class="mt-8 text-gray-700">See it in <a href="<%= users_pair_requests_path %>" class="text-purple font-bold">your partner searches</a>.</p>
  <% else %>
    <p class="mt-8 text-gray-700">You can't accept this application anymore. <a href="<%= users_pair_requests_path %>" class="text-purple font-bold">See your partner searches</a>.</p>
  <% end %>
</div>
